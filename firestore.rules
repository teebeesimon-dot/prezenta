rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userExists() ? userDoc().data.role : null;
    }

    function isSuperAdmin() {
      return userExists() && userRole() == 'super_admin';
    }

    function isOrganizer() {
      return userExists() && userRole() == 'organizer';
    }

    function isSeriesMember(seriesId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/members/$(seriesId + '_' + request.auth.uid));
    }

    function canCreateEvents() {
      return isSuperAdmin() || isOrganizer();
    }

    function canReadUserProfiles() {
      return isSuperAdmin() || isOrganizer();
    }

    function isSuperAdminEmail() {
      return isAuthenticated()
        && request.auth.token.email == 'teebeesimon@gmail.com';
    }

    function initialRoleForNewUser() {
      return isSuperAdminEmail() ? 'super_admin' : 'user';
    }

    function validAttendanceStatus(status) {
      return status in ['vin', 'poate', 'nu_vin'];
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || canReadUserProfiles());
      allow list: if canReadUserProfiles();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.uid == userId && request.resource.data.email == request.auth.token.email && request.resource.data.role == initialRoleForNewUser() && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt']);
      allow update: if isAuthenticated() && ((request.auth.uid == userId && (roleUnchanged() || (isSuperAdminEmail() && request.resource.data.role == 'super_admin'))) || (isSuperAdmin() && request.auth.uid != userId && request.resource.data.role in ['user', 'organizer'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])));
      allow delete: if false;
    }

    match /events/{eventId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated()
        && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || ('seriesId' in resource.data && isSeriesMember(resource.data.seriesId))
        );

      allow create: if canCreateEvents()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'sport', 'date', 'time', 'maxParticipants', 'ownerId', 'createdAt'
        ]);

      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isSuperAdmin()
      );
    }

    match /series/{seriesId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if canCreateEvents() && request.resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasAll(['title', 'sport', 'time', 'maxParticipants', 'ownerId', 'frequency', 'startDate', 'status', 'paymentModel', 'currentEventId', 'currentOccurrenceDate', 'createdAt']);
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }

    match /responses/{responseId} {
      function isResponseOwner() { return isAuthenticated() && resource.data.userId == request.auth.uid; }
      function isCreatingOwnResponse() { return isAuthenticated() && request.resource.data.userId == request.auth.uid && responseId == request.resource.data.eventId + '_' + request.auth.uid && validAttendanceStatus(request.resource.data.status); }
      allow get, list: if isAuthenticated();
      allow create: if isCreatingOwnResponse() && request.resource.data.keys().hasAll(['eventId', 'userId', 'status', 'createdAt']);
      allow update: if isResponseOwner() && request.resource.data.userId == request.auth.uid && request.resource.data.eventId == resource.data.eventId && validAttendanceStatus(request.resource.data.status);
      allow delete: if isResponseOwner();
    }

    match /subscriptions/{subscriptionId} {
      allow get, list: if isAuthenticated();
      allow create: if canCreateEvents() && request.resource.data.createdBy == request.auth.uid && subscriptionId == request.resource.data.userId + '_' + request.resource.data.month && request.resource.data.keys().hasAll(['userId', 'month', 'createdBy', 'createdAt']);
      allow delete: if canCreateEvents();
      allow update: if false;
    }

    match /members/{memberId} {
      function isGroupOwner() { return isAuthenticated() && resource.data.ownerId == request.auth.uid; }
      function validMemberId() { return memberId == request.resource.data.groupId + '_' + request.resource.data.userId; }
      function isJoiningSelf() { return isAuthenticated() && request.resource.data.userId == request.auth.uid && validMemberId(); }
      function isOwnerAddingMember() { return validMemberId() && (request.resource.data.ownerId == request.auth.uid || isSuperAdmin()); }
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && (isJoiningSelf() || isOwnerAddingMember()) && request.resource.data.keys().hasAll(['groupId', 'groupType', 'ownerId', 'userId', 'joinedAt']);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.groupId == resource.data.groupId && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isGroupOwner() || isSuperAdmin());
    }

    match /playerCards/{cardId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /stageConfigs/{stageId} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /stageCards/{cardId} {
      allow get, list: if isAuthenticated();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /stageVotes/{voteId} {
      function validVoteId() { return voteId == request.resource.data.groupId + '_' + request.resource.data.stageId + '_' + request.resource.data.awardId + '_' + request.resource.data.voterUserId; }
      function voterIsMember() { return exists(/databases/$(database)/documents/members/$(request.resource.data.groupId + '_' + request.auth.uid)); }
      function candidateIsMember() { return exists(/databases/$(database)/documents/members/$(request.resource.data.groupId + '_' + request.resource.data.candidateUserId)); }
      function stageConfig() { return get(/databases/$(database)/documents/stageConfigs/$(request.resource.data.stageId)); }
      function votingIsOpen() { return stageConfig().data.votingOpen == true; }
      function voteMatchesStageConfig() {
        return stageConfig().data.groupId == request.resource.data.groupId
          && request.resource.data.awardId in stageConfig().data.awardIds;
      }
      allow get: if isAuthenticated() && (isSuperAdmin() || resource.data.voterUserId == request.auth.uid);
      allow list: if isSuperAdmin() || (isAuthenticated() && resource.data.voterUserId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.voterUserId == request.auth.uid && validVoteId() && voterIsMember() && candidateIsMember() && votingIsOpen() && voteMatchesStageConfig() && request.resource.data.keys().hasOnly(['groupId', 'stageId', 'awardId', 'voterUserId', 'candidateUserId', 'createdAt']);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
